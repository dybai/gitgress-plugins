{
  "name": "gitgress",
  "displayName": "GitGress",
  "description": "Multi-lane commit graph, paginated history, changed files, and parent-commit diffs",
  "version": "1.0.26",
  "publisher": "dybai",
  "license": "MIT",
  "icon": "media/gitgress-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dybai/gitgress-plugins.git"
  },
  "homepage": "https://github.com/dybai/gitgress-plugins",
  "bugs": {
    "url": "https://github.com/dybai/gitgress-plugins/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "commit",
    "history",
    "graph",
    "scm",
    "diff",
    "merge",
    "repository",
    "gitgress"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitgress",
          "title": "GitGress",
          "icon": "media/gitgress-icon.svg"
        }
      ]
    },
    "views": {
      "gitgress": [
        {
          "type": "webview",
          "id": "gitgress.commits",
          "name": "Commits"
        },
        {
          "type": "webview",
          "id": "gitgress.files",
          "name": "Files"
        }
      ]
    },
    "configuration": {
      "title": "GitGress",
      "properties": {
        "gitgress.editorBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a current-line blame annotation at the end of the active editor line."
        },
        "gitgress.editorBlame.conflictMode": {
          "type": "string",
          "enum": ["ask", "alwaysShow", "defer"],
          "default": "ask",
          "description": "When another extension (GitLens) also shows current-line blame: ask once per session, always show GitGress, or defer to the other extension."
        }
      }
    },
    "colors": [
      {
        "id": "gitgress.blameAnnotationForeground",
        "description": "Foreground color of the inline current-line blame annotation",
        "defaults": {
          "dark": "#99999959",
          "light": "#99999959",
          "highContrast": "#99999999"
        }
      }
    ],
    "commands": [
      {
        "command": "gitgress.selectRepository",
        "title": "GitGress: Select Repository",
        "icon": "$(repo)"
      },
      {
        "command": "gitgress.switchBranch",
        "title": "GitGress: Switch Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitgress.refresh",
        "title": "GitGress: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitgress.openFileDiff",
        "title": "GitGress: Open File Diff"
      },
      {
        "command": "gitgress.revealFromBlame",
        "title": "GitGress: Reveal Commit from Blame"
      },
      {
        "command": "gitgress.copyBlameHash",
        "title": "GitGress: Copy Blame Commit Hash"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitgress.openFileDiff",
          "when": "false"
        },
        {
          "command": "gitgress.revealFromBlame",
          "when": "false"
        },
        {
          "command": "gitgress.copyBlameHash",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitgress.selectRepository",
          "when": "view == gitgress.commits && gitgress.hasRepositories",
          "group": "navigation@1"
        },
        {
          "command": "gitgress.switchBranch",
          "when": "view == gitgress.commits && gitgress.hasRepository",
          "group": "navigation@2"
        },
        {
          "command": "gitgress.refresh",
          "when": "view == gitgress.commits || view == gitgress.files",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build:webview": "node scripts/build-webview.mjs",
    "watch:webview": "node scripts/build-webview.mjs --watch",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}

